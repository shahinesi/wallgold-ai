# WallGold
WALLGOLD_BASE_URL=https://api.wallgold.ir
# API Key خصوصی WallGold. آن را در ChatGPT/Codex یا Git قرار ندهید.
WALLGOLD_API_KEY=
# WALLGOLD_TOKEN فقط برای سازگاری نسخه‌های قدیمی پشتیبانی می‌شود؛ برای نصب جدید استفاده نکنید.
# WALLGOLD_TOKEN=
WALLGOLD_DEFAULT_SYMBOL=GLD_18C_750TMN
WALLGOLD_REQUEST_TIMEOUT_MS=10000
# حداقل زمان باقی‌مانده از قیمت WallGold برای ورود به اجرای خصوصی.
WALLGOLD_MIN_EXECUTION_TTL_SECONDS=4

# MCP server
HOST=127.0.0.1
PORT=3000
MCP_SHARED_BEARER=
# فقط برای توسعه کنترل‌شده؛ روی bind غیرلوکال بدون auth فعال نکنید.
ALLOW_UNAUTHENTICATED_MCP=false
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# HMAC used for stateless preview tokens. Generate a long random value in production.
PREVIEW_SIGNING_SECRET=change-this-to-a-long-random-secret
# قیمت خصوصی WallGold کوتاه‌عمر است؛ پیش‌نمایش را عمداً کوتاه‌تر نگه می‌داریم.
PREVIEW_TTL_SECONDS=25
# توکن نتیجه تحلیل فقط برای ذخیره‌سازی امن همان خروجی Decision Engine استفاده می‌شود.
ANALYSIS_TOKEN_TTL_SECONDS=3600

# Public/plugin-safe mode. Keep FALSE for anything submitted publicly.
WALLGOLD_MCP_ALLOW_TRADE_EXECUTION=false

# Private/manual execution gateway. This is not required by the public plugin.
PRIVATE_EXECUTION_ENABLED=false
PRIVATE_MAX_ORDER_TOMAN=0
PRIVATE_MAX_ORDER_GRAMS=0

# Local persistence for policy/watchlists/shadow ledger (no WallGold API Key is stored here)
DATA_DIR=./data
