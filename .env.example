# WallGold
WALLGOLD_BASE_URL=https://api.wallgold.ir
# Optional only for local/STDIO or private non-OAuth use. Never paste this key into ChatGPT/Codex.
WALLGOLD_API_KEY=
# WALLGOLD_TOKEN remains as a backward-compatible alias only.
# WALLGOLD_TOKEN=
WALLGOLD_DEFAULT_SYMBOL=GLD_18C_750TMN
WALLGOLD_REQUEST_TIMEOUT_MS=10000
WALLGOLD_MIN_EXECUTION_TTL_SECONDS=4

# MCP server
HOST=127.0.0.1
PORT=3000
# ChatGPT remote MCP: OAuth 2.1 + PKCE. Codespaces enables this automatically.
MCP_OAUTH_ENABLED=false
# Exact external HTTPS origin for OAuth issuer/resource metadata in non-Codespaces deployments.
# Example: https://wallgold-ai.example.com
# Codespaces derives this automatically from CODESPACE_NAME + forwarded port.
MCP_PUBLIC_BASE_URL=
# Shared bearer is only for private non-ChatGPT clients when OAuth is disabled.
MCP_SHARED_BEARER=
# Development only. Never expose account data on a public bind with this enabled.
ALLOW_UNAUTHENTICATED_MCP=false
# Leave empty when MCP_PUBLIC_BASE_URL is configured to derive its exact hostname automatically.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# HMAC used for stateless preview tokens. Generate a long random value in production.
PREVIEW_SIGNING_SECRET=change-this-to-a-long-random-secret
PREVIEW_TTL_SECONDS=25
ANALYSIS_TOKEN_TTL_SECONDS=3600

# Public/plugin-safe mode. Keep FALSE for anything submitted publicly.
WALLGOLD_MCP_ALLOW_TRADE_EXECUTION=false

# Private/manual execution gateway. This is not required by the public plugin.
PRIVATE_EXECUTION_ENABLED=false
PRIVATE_MAX_ORDER_TOMAN=0
PRIVATE_MAX_ORDER_GRAMS=0

# Local persistence for policy/watchlists/shadow ledger and OAuth public client metadata.
# OAuth access/refresh tokens and WallGold API keys are NOT persisted in the Codespaces prototype.
DATA_DIR=./data
